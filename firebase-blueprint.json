{
  "entities": {
    "Participant": {
      "title": "Participant",
      "description": "An attendee profile in the matchmaking candidate pool.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "age": { "type": "number" },
        "occupation": { "type": "string", "maxLength": 150 },
        "location": { "type": "string", "maxLength": 150 },
        "marital": { "type": "string", "enum": ["Single", "Divorced", "Widowed"] },
        "smoking": { "type": "string", "enum": ["Non-Smoker", "Smoker"] },
        "hobbies": { "type": "array" },
        "ideal": { "type": "string", "maxLength": 1000 },
        "photo": { "type": "string", "maxLength": 500000 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 150 }
      },
      "required": [
        "id",
        "name",
        "gender",
        "age",
        "occupation",
        "location",
        "marital",
        "smoking",
        "hobbies",
        "ideal",
        "ownerId"
      ]
    },
    "MatchResult": {
      "title": "MatchResult",
      "description": "An algorithmic compatibility pairing result generated by AI.",
      "type": "object",
      "properties": {
        "rank": { "type": "number" },
        "maleId": { "type": "string", "maxLength": 128 },
        "femaleId": { "type": "string", "maxLength": 128 },
        "maleName": { "type": "string", "maxLength": 150 },
        "femaleName": { "type": "string", "maxLength": 150 },
        "maleAge": { "type": "number" },
        "femaleAge": { "type": "number" },
        "maleOccupation": { "type": "string", "maxLength": 150 },
        "femaleOccupation": { "type": "string", "maxLength": 150 },
        "maleLocation": { "type": "string", "maxLength": 150 },
        "femaleLocation": { "type": "string", "maxLength": 150 },
        "maleSmoking": { "type": "string", "maxLength": 50 },
        "femaleSmoking": { "type": "string", "maxLength": 50 },
        "maleHobbies": { "type": "array" },
        "femaleHobbies": { "type": "array" },
        "malePhoto": { "type": "string", "maxLength": 500000 },
        "femalePhoto": { "type": "string", "maxLength": 500000 },
        "score": { "type": "number" },
        "whyTheyMatch": { "type": "string", "maxLength": 3000 },
        "potentialChallenges": { "type": "string", "maxLength": 3000 },
        "recommendedActivities": { "type": "array" },
        "valueSynthesisPercent": { "type": "number" },
        "frictionProbabilityPercent": { "type": "number" },
        "crossCheckedTraits": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 100 },
        "ownerId": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "rank",
        "maleName",
        "femaleName",
        "score",
        "whyTheyMatch",
        "potentialChallenges",
        "recommendedActivities"
      ]
    },
    "SavedMatchSession": {
      "title": "SavedMatchSession",
      "description": "An archived session containing top AI matches and publish status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "matches": { "type": "array" },
        "isPublished": { "type": "boolean" },
        "savedBy": { "type": "string", "maxLength": 150 },
        "participantsCount": { "type": "number" }
      },
      "required": [
        "id",
        "title",
        "createdAt",
        "matches",
        "isPublished",
        "participantsCount"
      ]
    },
    "AiChatSession": {
      "title": "AiChatSession",
      "description": "Conversation log between a participant and AI Dating Advisor about their official partner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "participantId": { "type": "string", "maxLength": 128 },
        "participantName": { "type": "string", "maxLength": 150 },
        "participantEmail": { "type": "string", "maxLength": 150 },
        "partnerId": { "type": "string", "maxLength": 128 },
        "partnerName": { "type": "string", "maxLength": 150 },
        "coupleRank": { "type": "number" },
        "messages": { "type": "array" },
        "lastMessage": { "type": "string", "maxLength": 2000 },
        "lastUpdated": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": [
        "id",
        "participantId",
        "participantName",
        "partnerName",
        "messages"
      ]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Real-time global event state such as active matches and publication status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "matches": { "type": "array" },
        "matchesPublished": { "type": "boolean" },
        "activeSessionId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": [
        "id",
        "matchesPublished"
      ]
    }
  },
  "firestore": {
    "/participants/{participantId}": {
      "schema": { "$ref": "#/entities/Participant" },
      "description": "Collection of attendee candidate profiles stored by organizers and attendees."
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/MatchResult" },
      "description": "Collection of individual compatibility match records."
    },
    "/saved_match_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/SavedMatchSession" },
      "description": "Collection of saved AI matchmaking sessions and publish state."
    },
    "/ai_chats/{chatId}": {
      "schema": { "$ref": "#/entities/AiChatSession" },
      "description": "Collection of participant AI chat conversations accessible by participants and organizers."
    },
    "/system_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSetting" },
      "description": "Global synchronized application settings and published matching state."
    }
  }
}
